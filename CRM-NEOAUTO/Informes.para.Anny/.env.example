# Este es un archivo de ejemplo. Anny debe copiar estos valores en su propia computadora.
# IMPORTANTE: No subir el archivo .env real a GIT por seguridad.

# 1. Copiar estas claves en un archivo llamado .env en la RAÍZ del proyecto:
SUPABASE_URL=TU_URL_DE_PROYECTO_AQUÍ
SUPABASE_KEY=TU_ANON_KEY_AQUÍ

# 2. Copiar estas claves en un archivo llamado .env dentro de la carpeta 'whatsapp_bot':
SUPABASE_URL_CRM=TU_URL_DE_PROYECTO_CRM_AQUÍ
SUPABASE_KEY_CRM=TU_ANON_KEY_CRM_AQUÍ
ANTHROPIC_API_KEY=TU_API_KEY_DE_ANTHROPIC_AQUÍ
